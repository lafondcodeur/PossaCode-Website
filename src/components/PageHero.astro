---
// Bandeau d'en-tête des pages secondaires : titre (slot), sous-titre et CTA optionnels, sur fond bleu PossaCode.
import SectionHeading from './SectionHeading.astro';

interface Props {
    subtitle?: string;
}

const { subtitle } = Astro.props;
---

<section class="bg-blue-possacode px-6 md:px-10 py-16 md:py-24 text-center">
    <SectionHeading as="h1" class="text-white lg:text-6xl leading-tight max-w-4xl">
        <slot />
    </SectionHeading>
    {subtitle && (
        <p class="text-white/85 font-nunito font-light text-base md:text-xl max-w-2xl mx-auto mt-6">{subtitle}</p>
    )}
    {Astro.slots.has('actions') && (
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-8 md:mt-10">
            <slot name="actions" />
        </div>
    )}
</section>
