---
// Bloc titre + contenu des pages légales (mentions légales, confidentialité).
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<section class="space-y-3">
    <h2 class="font-Phudu font-bold text-blue-possacode text-2xl md:text-3xl">{title}</h2>
    <div class="font-nunito text-gray-700 text-base leading-relaxed space-y-3 [&_a]:text-blue-possacode [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-orange-possacode-ink [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2">
        <slot />
    </div>
</section>
