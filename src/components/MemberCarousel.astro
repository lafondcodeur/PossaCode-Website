---
import type { MemberPreview } from '../data/members-preview';

interface Props {
    members: MemberPreview[];
    /** aria-label de la région carrousel, pour différencier plusieurs instances sur le site. */
    label?: string;
}

const { members, label = 'Portraits de membres' } = Astro.props;
---

<div class="relative px-6 md:px-10" data-carousel>
    <div
        class="carousel-track flex gap-3 md:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2"
        data-carousel-track
        role="region"
        aria-label={label}
        aria-roledescription="carrousel"
        tabindex="0"
    >
        {members.map((member) => (
            <a
                href={`/members/${member.slug}`}
                class="group relative shrink-0 snap-start w-1/3 sm:w-1/5 md:w-1/6 h-52 sm:h-64 md:h-96 rounded-2xl overflow-hidden shadow-lg shadow-blue-possacode/15 ring-0 ring-orange-possacode transition-all duration-300 hover:ring-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode bg-[#e9ecf7]"
            >
                <img
                    class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-110"
                    src={member.image}
                    alt={member.name}
                />
                <div class="absolute inset-0 flex flex-col justify-end p-4 bg-linear-to-t from-blue-possacode/95 via-blue-possacode/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <p class="font-Phudu font-bold text-white text-base md:text-lg leading-tight">{member.name}</p>
                    <p class="font-nunito text-white/80 text-xs md:text-sm mt-1">{member.role}</p>
                    <span class="font-nunito text-orange-possacode font-semibold text-xs md:text-sm mt-2 inline-flex items-center gap-1">
                        Voir plus
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </span>
                </div>
            </a>
        ))}
    </div>

    <button
        type="button"
        data-carousel-prev
        aria-label="Portrait précédent"
        class="hidden md:flex absolute top-1/2 -left-4 -translate-y-1/2 items-center justify-center w-10 h-10 rounded-full bg-white shadow-lg text-blue-possacode hover:bg-orange-possacode hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
    >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button
        type="button"
        data-carousel-next
        aria-label="Portrait suivant"
        class="hidden md:flex absolute top-1/2 -right-4 -translate-y-1/2 items-center justify-center w-10 h-10 rounded-full bg-white shadow-lg text-blue-possacode hover:bg-orange-possacode hover:text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
    >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>

    <div class="flex justify-center gap-2 mt-5">
        {members.map((member, i) => (
            <button
                type="button"
                data-carousel-dot={i}
                aria-label={`Aller au portrait de ${member.name}`}
                class="w-2.5 h-2.5 rounded-full bg-gray-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
            ></button>
        ))}
    </div>
</div>

<script>
    const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

    carousels.forEach((root) => {
        const track = root.querySelector<HTMLElement>('[data-carousel-track]');
        const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
        const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
        const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
        const cards = track ? (Array.from(track.children) as HTMLElement[]) : [];
        if (!track || cards.length === 0) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

        // Pas de compteur d'index mémorisé : la carte "active" est toujours recalculée à partir de
        // la position de scroll réelle. Un compteur mémorisé se désynchronise près de la fin — la
        // dernière carte ne peut pas toujours atteindre le bord gauche (le scroll est limité par le
        // navigateur à `scrollWidth - clientWidth`), donc cibler "l'index suivant" par un compteur
        // pouvait demander deux fois la même position déjà atteinte : aucun scroll réel, aucun
        // évènement `scroll`, plus aucune progression possible (bloqué en boucle, vérifié en direct
        // via CDP : `scrollLeft` figé pendant 15s alors que l'auto-défilement était censé tourner).
        const getClosestIndex = () => {
            let closestIndex = 0;
            let closestDistance = Infinity;
            cards.forEach((card, i) => {
                const distance = Math.abs(card.offsetLeft - track.offsetLeft - track.scrollLeft);
                if (distance < closestDistance) {
                    closestDistance = distance;
                    closestIndex = i;
                }
            });
            return closestIndex;
        };

        const highlightDot = (index: number) => {
            dots.forEach((dot, i) => {
                dot.classList.toggle('bg-orange-possacode', i === index);
                dot.classList.toggle('bg-gray-300', i !== index);
            });
        };
        highlightDot(0);

        const scrollToIndex = (index: number) => {
            const card = cards[Math.max(0, Math.min(index, cards.length - 1))];
            if (!card) return;
            track.scrollTo({ left: card.offsetLeft - track.offsetLeft, behavior: scrollBehavior });
        };

        dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToIndex(i)));
        prevBtn?.addEventListener('click', () => scrollToIndex(getClosestIndex() - 1));
        nextBtn?.addEventListener('click', () => scrollToIndex(getClosestIndex() + 1));

        // Garde la pagination synchronisée avec tout défilement (tactile, molette, clavier,
        // programmatique) : la carte "active" est celle dont le bord gauche est le plus proche du
        // scroll actuel.
        let scrollRaf: number | undefined;
        track.addEventListener('scroll', () => {
            if (scrollRaf !== undefined) return;
            scrollRaf = requestAnimationFrame(() => {
                highlightDot(getClosestIndex());
                scrollRaf = undefined;
            });
        });

        let autoplayId: ReturnType<typeof setInterval> | undefined;
        const startAutoplay = () => {
            if (prefersReducedMotion || autoplayId) return;
            autoplayId = setInterval(() => {
                // Comparaison sur la position de scroll réelle (pas sur un index mémorisé) pour
                // garantir un retour au début même quand la dernière carte est en butée.
                const maxScroll = track.scrollWidth - track.clientWidth;
                if (track.scrollLeft >= maxScroll - 4) {
                    track.scrollTo({ left: 0, behavior: scrollBehavior });
                } else {
                    scrollToIndex(getClosestIndex() + 1);
                }
            }, 4000);
        };
        const stopAutoplay = () => {
            clearInterval(autoplayId);
            autoplayId = undefined;
        };

        root.addEventListener('mouseenter', stopAutoplay);
        root.addEventListener('mouseleave', startAutoplay);
        root.addEventListener('focusin', stopAutoplay);
        root.addEventListener('focusout', startAutoplay);
        // Le survol souris ne couvre pas le tactile : sans ça, l'auto-défilement peut se
        // déclencher pendant qu'un doigt fait glisser le carrousel sur mobile et entrer en conflit
        // avec le geste en cours.
        track.addEventListener('touchstart', stopAutoplay, { passive: true });
        track.addEventListener('touchend', startAutoplay);

        startAutoplay();
    });
</script>
