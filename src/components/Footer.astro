---
const year = new Date().getFullYear();
const CONTACT_EMAIL = "contact@possacode.org";
const SOCIAL_LINKS = [
    {
        name: "LinkedIn",
        url: "https://www.linkedin.com/company/possacode",
        path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    },
    {
        name: "X",
        url: "https://x.com/possacode",
        path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
    },
    {
        name: "Instagram",
        url: "https://www.instagram.com/possacode",
        path: "M12 0C8.74 0 8.333.014 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.986 8.74 24 12 24s3.667-.014 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.014-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.014 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.897 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.897-.421-.419-.69-.824-.897-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.207-.57.476-.96.897-1.381.419-.419.81-.689 1.379-.896.42-.166 1.051-.36 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z",
    },
];

const navLinks = [
    { label: "À propos", href: "/about" },
    { label: "Événements", href: "/event" },
    { label: "Communauté", href: "/community" },
    { label: "Nos Membres", href: "/members" },
];

const involvedLinks = [
    { label: "Nous rejoindre", href: "/join" },
    { label: "Faire un don", href: "/donate" },
    { label: "Devenir partenaire", href: "/partners" },
];
---

<footer class="bg-white text-gray-700 font-nunito border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-12 md:py-16">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
            <!-- Col 1: Brand -->
            <div class="space-y-4">
                <a href="/" class="inline-block rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode">
                    <img class="max-h-10 w-auto object-contain" src="/assets/possacodebb.jpg" alt="PossaCode">
                </a>
                <p class="text-sm">
                    Former, partager et inspirer la prochaine génération de développeurs africains.
                </p>
                <p class="text-xs text-gray-500">
                    #Former #Partager #Inspirer #Orienter #Réseauter
                </p>
            </div>

            <nav aria-label="Pied de page" class="contents">
                <!-- Col 2: Navigation -->
                <div>
                    <div class="inline-block mb-4">
                        <h2 class="text-blue-possacode font-Phudu font-bold text-lg">Navigation</h2>
                        <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                        </svg>
                    </div>
                    <ul class="space-y-2">
                        {navLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-sm text-gray-700 hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <!-- Col 3: S'impliquer -->
                <div>
                    <div class="inline-block mb-4">
                        <h2 class="text-blue-possacode font-Phudu font-bold text-lg">S'impliquer</h2>
                        <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                        </svg>
                    </div>
                    <ul class="space-y-2">
                        {involvedLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-sm text-gray-700 hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </nav>

            <!-- Col 4: Contact -->
            <div>
                <div class="inline-block mb-4">
                    <h2 class="text-blue-possacode font-Phudu font-bold text-lg">Contact</h2>
                    <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                    </svg>
                </div>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a
                            href={`mailto:${CONTACT_EMAIL}`}
                            class="text-gray-700 hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                        >
                            {CONTACT_EMAIL}
                        </a>
                    </li>
                    <li>Brazzaville, Congo</li>
                </ul>
                <div class="flex gap-4 mt-4">
                    {SOCIAL_LINKS.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`PossaCode sur ${social.name}`}
                            class="text-gray-700 hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d={social.path}></path>
                            </svg>
                        </a>
                    ))}
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-gray-200 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-500">
            <p>© {year} PossaCode. Tous droits réservés.</p>
            <div class="flex gap-6">
                <a
                    href="/mentions-legales"
                    class="hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                >
                    Mentions légales
                </a>
                <a
                    href="/confidentialite"
                    class="hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                >
                    Politique de confidentialité
                </a>
            </div>
        </div>
    </div>
</footer>
