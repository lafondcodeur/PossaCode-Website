---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import congoDevOpsLogo from '../assets/par/Congo DevOps.jpg';
import '../styles/global.css';

// Jalons temporaires (fictifs) — à remplacer par les vraies dates et événements de PossaCode avant mise en production.
const historyMilestones = [
    {
        year: '2023',
        title: 'Naissance de PossaCode',
        description: "Un noyau de développeurs passionnés se réunit pour donner vie à une communauté tech pensée pour et par la jeunesse africaine.",
        image: '/assets/heri.jpg',
        alt: 'Membre de PossaCode animant une session de formation devant un poster de présentation',
    },
    {
        year: '2024',
        title: 'Premier hackathon communautaire',
        description: 'PossaCode organise son tout premier hackathon, réunissant développeurs et porteurs de projets autour de défis techniques.',
        image: '/assets/A3.jpg',
        alt: 'Membres de la communauté PossaCode collaborant ensemble autour d\'une tablette',
    },
    {
        year: '2025',
        title: '1000 personnes impactées',
        description: 'Le cap symbolique des 1000 personnes accompagnées est franchi grâce aux formations et événements organisés.',
        image: '/assets/engroupe.jpg',
        alt: "Membres de la communauté PossaCode réunis lors d'un événement",
    },
    {
        year: '2026',
        title: "PossaCode aujourd'hui",
        description: "Plus de 80 membres actifs et une communauté toujours grandissante, portée par une vision claire pour l'avenir.",
        image: '/assets/groupe.jpg',
        alt: 'Grand groupe de membres de la communauté PossaCode réunis',
    },
];

const partnerLogos = [
    { src: '/assets/par/cgdt.jpg', alt: 'Logo partenaire CGDT', class: 'w-24 md:w-35 h-14 md:h-20 object-cover' },
    { src: "/assets/par/Logo de l'ACDN.png", alt: 'Logo partenaire ACDN', class: 'w-40 md:w-65 h-14 md:h-20 object-contain' },
    { src: '/assets/par/galsendev.jpg', alt: 'Logo partenaire GalsenDev', class: 'w-24 md:w-35 h-14 md:h-20 object-contain' },
    { src: '/assets/par/unionlab.jpg', alt: 'Logo partenaire UnionLab', class: 'w-24 md:w-35 h-16 md:h-25 object-cover' },
    { src: '/assets/par/logo.webp', alt: 'Logo partenaire Miabé Hackathon', class: 'w-36 md:w-55 h-14 md:h-20 object-contain' },
    { src: '/assets/par/logo-asso-10000codeurs.png', alt: 'Logo partenaire 10000 Codeurs', class: 'w-24 md:w-35 h-14 md:h-20 object-contain' },
];
---

<Layout title="A propos — PossaCode" description="PossaCode est la communauté qui met la technologie au service de la jeunesse africaine : formations, meetups et hackathons pour des développeurs qui apprennent et créent ensemble.">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
        <div class="relative min-h-140 md:min-h-160 flex items-center">
            <img
                src="/assets/A3.jpg"
                alt="Membres de la communauté PossaCode collaborant ensemble"
                class="absolute inset-0 w-full h-full object-cover object-center"
            />
            <div class="absolute inset-0 bg-linear-to-r from-blue-possacode via-blue-possacode/85 to-blue-possacode/30"></div>

            <div class="relative z-10 px-6 md:px-10 py-20 md:py-28 max-w-3xl">
                <div class="inline-block">
                    <h1 class="text-3xl md:text-5xl lg:text-6xl font-Phudu font-bold text-white leading-tight">
                        La communauté qui met la <span class="text-orange-possacode">technologie</span> au service de la jeunesse africaine.
                    </h1>
                    <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                    </svg>
                </div>

                <p class="text-white/85 font-nunito mt-5 max-w-xl text-base md:text-lg">
                    Nos formateurs et bénévoles apportent une culture tech accessible aux développeurs que nous accompagnons, à travers meetups, hackathons et formations, et grandissent avec la communauté.
                </p>

                <div class="flex flex-wrap gap-4 mt-8 md:mt-10">
                    <a href="/contact" class="boutton-standard text-orange-possacode-ink font-nunito text-sm md:text-base inline-flex items-center gap-2">
                        Nous contacter
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </a>
                    <a href="/event" class="bg-white text-blue-possacode font-nunito font-bold px-4 py-3 rounded-lg text-sm md:text-base inline-flex items-center gap-2 hover:bg-white/90 transition-colors">
                        Nos événements
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Bandeau de statistiques : pan diagonal blanc remontant sur la photo -->
        <div class="relative bg-white">
            <div class="absolute left-1/4 right-0 -top-10 md:-top-16 h-10 md:h-16 bg-white [clip-path:polygon(0_100%,100%_0,100%_100%)]"></div>
            <div class="relative grid grid-cols-3 divide-x divide-gray-200 px-6 md:px-10 py-8 md:py-12 text-center">
                <div>
                    <p class="text-2xl md:text-4xl font-Phudu font-bold text-orange-possacode">80+</p>
                    <p class="text-gray-500 font-nunito text-xs md:text-base mt-1">membres</p>
                </div>
                <div>
                    <p class="text-2xl md:text-4xl font-Phudu font-bold text-orange-possacode">1000+</p>
                    <p class="text-gray-500 font-nunito text-xs md:text-base mt-1">personnes impactées</p>
                </div>
                <div>
                    <p class="text-2xl md:text-4xl font-Phudu font-bold text-orange-possacode">5</p>
                    <p class="text-gray-500 font-nunito text-xs md:text-base mt-1">domaines d'expertise</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bandeau photo communauté -->
    <section class="w-full h-40 sm:h-52 md:h-64 lg:h-72 overflow-hidden">
        <img
            src="/assets/coworking.webp"
            alt="Jeunes de la communauté PossaCode travaillant ensemble autour d'un ordinateur portable"
            class="w-full h-full object-cover object-center"
        />
    </section>

    <!-- Partenaires Section -->
    <section class="px-6 md:px-10 py-16 md:py-24">
        <div class="flex justify-center">
            <div class="inline-block">
                <h2 class="text-3xl md:text-5xl font-Phudu font-bold text-blue-possacode text-center">Ces partenaires qui croient en nous</h2>
                <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
        </div>
        <div class="logo-marquee mt-10 md:mt-16">
            <div class="logo-marquee-track flex items-center">
                <div class="flex items-center gap-6 md:gap-10 pr-6 md:pr-10 shrink-0">
                    {partnerLogos.map((logo) => (
                        <img class={`${logo.class} shrink-0`} src={logo.src} alt={logo.alt} />
                    ))}
                    <Image class="w-24 md:w-35 h-14 md:h-20 object-cover shrink-0" src={congoDevOpsLogo} width={140} densities={[1, 2]} format="webp" alt="Logo partenaire Congo DevOps" />
                </div>
                <div class="flex items-center gap-6 md:gap-10 pr-6 md:pr-10 shrink-0" aria-hidden="true">
                    {partnerLogos.map((logo) => (
                        <img class={`${logo.class} shrink-0`} src={logo.src} alt="" />
                    ))}
                    <Image class="w-24 md:w-35 h-14 md:h-20 object-cover shrink-0" src={congoDevOpsLogo} width={140} densities={[1, 2]} format="webp" alt="" />
                </div>
            </div>
        </div>
    </section>

    <!-- Vision, Mission, Valeurs Section -->
    <section class="relative overflow-hidden mt-16 md:mt-24 px-6 md:px-10 py-12 md:py-20">
        <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
            <!-- Colonne texte + accordéon -->
            <div>
                <div class="inline-block">
                    <h2 class="text-3xl md:text-5xl font-Phudu font-bold text-blue-possacode">Notre Vision, Mission &amp; Valeurs</h2>
                    <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                    </svg>
                </div>
                <p class="text-gray-600 font-nunito mt-4 max-w-lg text-sm md:text-base">
                    De nos convictions à notre façon d'agir, voici ce qui anime PossaCode au quotidien : une communauté de développeurs portée par une vision claire, une mission concrète et des valeurs partagées.
                </p>

                <div class="mt-8 border-t border-gray-200" id="vmv-accordion">
                    <div class="border-b border-gray-200 py-5" data-item="vision">
                        <button type="button" class="w-full flex items-center justify-between gap-4 text-left cursor-pointer" data-accordion-trigger aria-expanded="true">
                            <span class="font-Phudu font-bold text-lg md:text-xl text-blue-possacode">Notre vision</span>
                            <span class="shrink-0 w-8 h-8 rounded-md bg-orange-possacode text-white flex items-center justify-center text-xl leading-none" data-accordion-icon>−</span>
                        </button>
                        <div class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-300" data-accordion-body>
                            <p class="overflow-hidden text-gray-600 font-nunito text-sm md:text-base pt-3 pr-6 md:pr-10">
                                Nous aspirons à créer une communauté de développeurs en Afrique qui soit inclusive, collaborative et innovante, où les membres peuvent s'entraider pour atteindre leurs objectifs professionnels et personnels, tout en contribuant au développement de l'écosystème technologique africain.
                            </p>
                        </div>
                    </div>

                    <div class="border-b border-gray-200 py-5" data-item="mission">
                        <button type="button" class="w-full flex items-center justify-between gap-4 text-left cursor-pointer" data-accordion-trigger aria-expanded="false">
                            <span class="font-Phudu font-bold text-lg md:text-xl text-blue-possacode">Notre mission</span>
                            <span class="shrink-0 w-8 h-8 rounded-md bg-blue-possacode text-white flex items-center justify-center text-xl leading-none" data-accordion-icon>+</span>
                        </button>
                        <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300" data-accordion-body>
                            <p class="overflow-hidden text-gray-600 font-nunito text-sm md:text-base pt-3 pr-6 md:pr-10">
                                Notre mission est de fournir une plateforme de formation, d'échange et de collaboration pour les développeurs en Afrique, afin de renforcer leurs compétences techniques, favoriser les opportunités de réseautage et d'échange d'expériences, et contribuer au développement de l'écosystème technologique africain.
                            </p>
                        </div>
                    </div>

                    <div class="border-b border-gray-200 py-5" data-item="valeurs">
                        <button type="button" class="w-full flex items-center justify-between gap-4 text-left cursor-pointer" data-accordion-trigger aria-expanded="false">
                            <span class="font-Phudu font-bold text-lg md:text-xl text-blue-possacode">Nos valeurs</span>
                            <span class="shrink-0 w-8 h-8 rounded-md bg-blue-possacode text-white flex items-center justify-center text-xl leading-none" data-accordion-icon>+</span>
                        </button>
                        <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300" data-accordion-body>
                            <p class="overflow-hidden text-gray-600 font-nunito text-sm md:text-base pt-3 pr-6 md:pr-10">
                                Nous valorisons l'inclusion, la collaboration, l'innovation, la diversité et l'impact social. Nous croyons que chaque membre de notre communauté a un rôle à jouer dans le développement de l'écosystème technologique africain, et nous nous engageons à créer un environnement où chacun peut s'épanouir et contribuer à la croissance de notre communauté.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne mosaïque photos + panneaux -->
            <div class="grid grid-cols-2 grid-rows-3 gap-3 md:gap-4 h-[420px] md:h-[520px]" id="vmv-mosaic">
                <div class="relative rounded-xl overflow-hidden col-start-1 row-start-1">
                    <img src="/assets/NOUS.jpg" alt="Membres de la communauté PossaCode" class="absolute inset-0 w-full h-full object-cover object-top" />
                </div>

                <div class="relative rounded-xl overflow-hidden col-start-2 row-start-1 row-span-2">
                    <img src="/assets/engroupe.jpg" alt="Membres de la communauté PossaCode réunis lors d'un événement" class="absolute inset-0 w-full h-full object-cover" />
                </div>

                <div class="relative rounded-xl overflow-hidden col-start-1 row-start-2 bg-blue-possacode p-4 md:p-5 flex flex-col justify-end transition-all duration-300 ring-4 ring-orange-possacode scale-[1.02]" data-panel="vision">
                    <p class="font-Phudu font-bold text-white text-base md:text-lg">Notre vision</p>
                    <p class="font-nunito text-white/90 text-xs md:text-sm mt-1 overflow-hidden transition-all duration-300 grid grid-rows-[1fr]" data-panel-text>
                        <span class="overflow-hidden line-clamp-2">Inclusive &amp; innovante</span>
                    </p>
                </div>

                <div class="relative rounded-xl overflow-hidden col-start-1 row-start-3 bg-orange-possacode p-4 md:p-5 flex flex-col justify-end transition-all duration-300" data-panel="mission">
                    <p class="font-Phudu font-bold text-orange-possacode-ink text-base md:text-lg">Notre mission</p>
                    <p class="font-nunito text-orange-possacode-ink text-xs md:text-sm mt-1 overflow-hidden transition-all duration-300 grid grid-rows-[0fr]" data-panel-text>
                        <span class="overflow-hidden line-clamp-2">Former &amp; connecter</span>
                    </p>
                </div>

                <div class="relative rounded-xl overflow-hidden col-start-2 row-start-3 bg-blue-possacode p-4 md:p-5 flex flex-col justify-end transition-all duration-300" data-panel="valeurs">
                    <p class="font-Phudu font-bold text-white text-base md:text-lg">Nos valeurs</p>
                    <p class="font-nunito text-white/90 text-xs md:text-sm mt-1 overflow-hidden transition-all duration-300 grid grid-rows-[0fr]" data-panel-text>
                        <span class="overflow-hidden line-clamp-2">Impact &amp; diversité</span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Notre Histoire Section -->
    <section class="px-6 md:px-10 py-16 md:py-24">
        <div class="flex justify-center">
            <div class="inline-block">
                <h2 class="text-3xl md:text-5xl font-Phudu font-bold text-blue-possacode text-center">Notre histoire</h2>
                <svg class="w-full h-3 mt-1" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
        </div>

        <div class="mt-10 md:mt-16 grid md:grid-cols-[1fr_2fr_1fr] gap-x-6 md:gap-x-10">
            {historyMilestones.map((milestone, index) => (
                <>
                    <!-- Photo à gauche (jalons pairs) -->
                    <div class="hidden md:flex items-start">
                        {index % 2 === 0 && (
                            <div class="history-reveal relative w-full rounded-2xl overflow-hidden shadow-blue-possacode/15 shadow-xl aspect-4/3">
                                <img src={milestone.image} alt={milestone.alt} class="w-full h-full object-cover" />
                                <span class="absolute top-3 left-3 bg-white/90 text-blue-possacode font-Phudu font-bold text-xs px-3 py-1 rounded-full">{milestone.year}</span>
                                <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-blue-possacode/90 to-transparent px-4 pt-8 pb-3">
                                    <p class="text-white font-Phudu font-bold text-sm md:text-base">{milestone.title}</p>
                                </div>
                            </div>
                        )}
                    </div>

                    <!-- Jalon : puce, ligne verticale, année, titre, description -->
                    <div class={`history-reveal relative pl-14 md:pl-16 ${index === historyMilestones.length - 1 ? 'pb-0' : 'pb-10 md:pb-14'}`}>
                        {index !== historyMilestones.length - 1 && (
                            <span class="absolute left-10 md:left-12 top-1 bottom-0 w-0.5 bg-blue-possacode/15"></span>
                        )}
                        <span class="absolute left-0 top-0 w-10 md:w-12 pr-3 text-right font-Phudu font-bold text-orange-possacode text-base md:text-lg">{milestone.year}</span>
                        <span class="history-dot-reveal absolute left-[calc(2.5rem-5px)] md:left-[calc(3rem-5px)] top-0.5 w-2.5 h-2.5 rounded-full bg-orange-possacode ring-4 ring-orange-possacode/20"></span>
                        <p class="font-Phudu font-bold text-blue-possacode text-lg md:text-xl">{milestone.title}</p>
                        <p class="text-gray-600 font-nunito text-sm md:text-base mt-2 max-w-md">{milestone.description}</p>
                    </div>

                    <!-- Photo à droite (jalons impairs) -->
                    <div class="hidden md:flex items-start">
                        {index % 2 === 1 && (
                            <div class="history-reveal relative w-full rounded-2xl overflow-hidden shadow-blue-possacode/15 shadow-xl aspect-4/3">
                                <img src={milestone.image} alt={milestone.alt} class="w-full h-full object-cover" />
                                <span class="absolute top-3 left-3 bg-white/90 text-blue-possacode font-Phudu font-bold text-xs px-3 py-1 rounded-full">{milestone.year}</span>
                                <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-blue-possacode/90 to-transparent px-4 pt-8 pb-3">
                                    <p class="text-white font-Phudu font-bold text-sm md:text-base">{milestone.title}</p>
                                </div>
                            </div>
                        )}
                    </div>
                </>
            ))}
        </div>
    </section>
</Layout>

<script>
    const historyRevealTargets = document.querySelectorAll<HTMLElement>('.history-reveal, .history-dot-reveal');
    if ('IntersectionObserver' in window) {
        const historyRevealObserver = new IntersectionObserver(
            (entries, observer) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
        );
        historyRevealTargets.forEach((el) => historyRevealObserver.observe(el));
    } else {
        historyRevealTargets.forEach((el) => el.classList.add('is-visible'));
    }

    const accordionItems = document.querySelectorAll<HTMLElement>('#vmv-accordion [data-item]');
    const panels = document.querySelectorAll<HTMLElement>('#vmv-mosaic [data-panel]');

    function setActive(key: string | undefined) {
        accordionItems.forEach((item) => {
            const isActive = item.dataset.item === key;
            const body = item.querySelector<HTMLElement>('[data-accordion-body]');
            const icon = item.querySelector<HTMLElement>('[data-accordion-icon]');
            const trigger = item.querySelector<HTMLElement>('[data-accordion-trigger]');
            body?.classList.toggle('grid-rows-[1fr]', isActive);
            body?.classList.toggle('grid-rows-[0fr]', !isActive);
            if (icon) icon.textContent = isActive ? '−' : '+';
            icon?.classList.toggle('bg-orange-possacode', isActive);
            icon?.classList.toggle('bg-blue-possacode', !isActive);
            trigger?.setAttribute('aria-expanded', String(isActive));
        });

        panels.forEach((panel) => {
            const isActive = panel.dataset.panel === key;
            const text = panel.querySelector<HTMLElement>('[data-panel-text]');
            panel.classList.toggle('ring-4', isActive);
            panel.classList.toggle('ring-orange-possacode', isActive);
            panel.classList.toggle('scale-[1.02]', isActive);
            text?.classList.toggle('grid-rows-[1fr]', isActive);
            text?.classList.toggle('grid-rows-[0fr]', !isActive);
        });
    }

    accordionItems.forEach((item) => {
        item.querySelector('[data-accordion-trigger]')?.addEventListener('click', () => {
            setActive(item.dataset.item);
        });
    });
</script>