---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Image } from 'astro:assets';
import congoDevOpsLogo from '../assets/par/Congo DevOps.jpg';
import { partnerLogos } from '../data/partner-logos';

const partnershipTypes = [
    { title: 'Sponsoriser un événement', text: 'Soutenez un DevDay, un hackathon ou une conférence et associez votre marque à la communauté tech.' },
    { title: 'Accueillir la communauté', text: 'Mettez à disposition une salle ou un espace pour nos meetups et formations.' },
    { title: 'Partager votre expertise', text: 'Proposez des intervenants, des mentors ou des ateliers animés par vos équipes.' },
    { title: 'Ouvrir des opportunités', text: "Diffusez vos offres de stage, d'emploi ou de mission auprès de nos membres." },
];

const gains = [
    'Une visibilité auprès de plus de 1000 personnes touchées par nos actions',
    'Un accès direct à des talents tech motivés au Congo et en Afrique',
    "Un impact concret sur la formation de la jeunesse africaine",
    "Une place dans un réseau d'associations et d'entreprises engagées",
];
---

<Layout title="Partenaires — PossaCode" description="Devenez partenaire de PossaCode : sponsoring d'événements, accueil, mentorat et opportunités pour les développeurs du Congo et d'Afrique.">
    <PageHero subtitle="Entreprises, associations et institutions : construisons ensemble l'écosystème tech africain.">
        Devenez <span class="text-orange-possacode-light">partenaire</span>
        <Fragment slot="actions">
            <a href="/contact?sujet=partenariat" class="boutton-standard text-orange-possacode-ink text-base md:text-lg px-8 py-3">Proposer un partenariat</a>
        </Fragment>
    </PageHero>

    <!-- Partenaires actuels -->
    <section class="px-6 md:px-10 py-16 md:py-24">
        <SectionHeading>Ils nous font <span class="text-orange-possacode-ink">confiance</span></SectionHeading>
        <ul class="mt-10 md:mt-16 flex flex-wrap justify-center items-center gap-8 md:gap-12">
            {partnerLogos.map((logo) => (
                <li><img class={logo.class} src={logo.src} alt={logo.alt} loading="lazy" /></li>
            ))}
            <li><Image class="w-24 md:w-35 h-14 md:h-20 object-cover" src={congoDevOpsLogo} width={140} densities={[1, 2]} format="webp" alt="Logo partenaire Congo DevOps" /></li>
        </ul>
    </section>

    <!-- Formes de partenariat -->
    <section class="bg-gray-50 px-6 md:px-10 py-16 md:py-24">
        <SectionHeading>Comment collaborer ?</SectionHeading>
        <div class="mt-10 md:mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {partnershipTypes.map((type) => (
                <div class="rounded-2xl bg-white border-2 border-blue-possacode/10 p-6 md:p-8 hover:border-orange-possacode transition-colors">
                    <h3 class="font-Phudu font-bold text-blue-possacode text-xl">{type.title}</h3>
                    <p class="text-gray-600 font-nunito text-sm md:text-base mt-3">{type.text}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- Ce que vous y gagnez -->
    <section class="bg-orange-possacode px-6 md:px-10 py-16 md:py-24">
        <div class="max-w-4xl mx-auto">
            <SectionHeading stroke="#1a2251" class="text-blue-possacode">Ce que vous y gagnez</SectionHeading>
            <ul class="mt-10 md:mt-14 grid gap-4 md:grid-cols-2">
                {gains.map((gain) => (
                    <li class="flex gap-3 items-start bg-white/90 rounded-xl p-5">
                        <svg class="w-6 h-6 shrink-0 text-blue-possacode" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-orange-possacode-ink font-nunito font-semibold">{gain}</span>
                    </li>
                ))}
            </ul>
            <div class="flex justify-center mt-12">
                <a href="/contact?sujet=partenariat" class="bg-blue-possacode text-white font-nunito font-bold px-8 py-3 rounded-lg text-base md:text-lg hover:bg-blue-possacode/90 transition">Discutons-en</a>
            </div>
        </div>
    </section>
</Layout>
