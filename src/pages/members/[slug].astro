---
import Layout from '../../layouts/Layout.astro';
import { membersDirectory, memberCategories, type DirectoryMember } from '../../data/members-directory';
import { buildMemberBio } from '../../utils/member-bio';
import { getSkillIcon } from '../../data/skill-icons';

export function getStaticPaths() {
    return membersDirectory.map((member) => ({
        params: { slug: member.slug },
        props: { member },
    }));
}

type Props = { member: DirectoryMember };

const { member } = Astro.props;
const bio = buildMemberBio(member);
const categoryLabel = memberCategories.find((c) => c.id === member.category)?.label ?? '';

const socialLinks = [
    {
        name: 'LinkedIn',
        url: member.link,
        path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    },
    {
        name: 'GitHub',
        url: member.github,
        path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
    },
];
---

<Layout title={`${member.name} — PossaCode`} description={bio.slice(0, 155)}>
    <section class="px-6 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24 bg-linear-to-b from-[#e9ecf7] via-[#f6f7fb] to-white">
        <div class="max-w-5xl mx-auto">
            <a
                href="/members"
                class="inline-flex items-center gap-1.5 font-nunito text-sm text-blue-possacode hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode mb-8"
            >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Retour à Nos Membres
            </a>

            <div class="bg-white rounded-3xl border border-gray-200 shadow-xl shadow-blue-possacode/10 p-6 md:p-10 grid md:grid-cols-[240px_1fr] gap-8 md:gap-10">
                <!-- Photo + note -->
                <div>
                    <img
                        class="w-full aspect-square object-cover object-top rounded-2xl bg-gray-100"
                        src={member.image}
                        alt={member.name}
                        loading="lazy"
                        decoding="async"
                    />
                    <p class="mt-4 text-center font-nunito text-sm text-gray-600">
                        <span class="text-orange-possacode">★</span> {member.rating.toFixed(1)} ({member.reviewCount} avis)
                    </p>
                </div>

                <!-- Infos -->
                <div>
                    <span class="inline-block font-nunito text-xs font-semibold uppercase tracking-wide text-orange-possacode bg-[#fff3ee] rounded-full px-3 py-1">
                        {categoryLabel}
                    </span>
                    <h1 class="mt-3 font-Phudu font-bold text-3xl md:text-4xl text-blue-possacode leading-tight">
                        {member.name}
                    </h1>
                    <p class="font-nunito text-gray-500 text-base md:text-lg mt-1">{member.role}</p>

                    <p class="font-nunito text-gray-600 mt-6 leading-relaxed">{bio}</p>

                    <div class="mt-8 flex flex-wrap items-center gap-4">
                        <button
                            type="button"
                            disabled
                            title="CV bientôt disponible"
                            class="inline-flex items-center gap-2 rounded-lg border border-blue-possacode text-blue-possacode font-nunito font-semibold text-sm px-5 py-3 opacity-60 cursor-not-allowed"
                        >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
                            </svg>
                            Télécharger le CV
                        </button>

                        <div class="flex items-center gap-3">
                            {socialLinks.map((social) => (
                                <a
                                    href={social.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`Profil ${social.name} de ${member.name}`}
                                    class="text-blue-possacode hover:text-orange-possacode transition rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                                >
                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d={social.path}></path>
                                    </svg>
                                </a>
                            ))}
                        </div>
                    </div>

                    <div class="mt-10">
                        <h2 class="font-Phudu font-bold text-blue-possacode text-lg">Compétences</h2>
                        <div class="flex flex-wrap gap-2 mt-3">
                            {member.skills.map((skill) => {
                                const icon = getSkillIcon(skill);
                                return (
                                    <span class="inline-flex items-center gap-1.5 font-nunito text-sm text-blue-possacode bg-[#e9ecf7] rounded-full px-3 py-1.5">
                                        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill={`#${icon.hex}`} aria-hidden="true">
                                            <path d={icon.path}></path>
                                        </svg>
                                        {skill}
                                    </span>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
