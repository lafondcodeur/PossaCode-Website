---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import congoDevOpsLogo from '../assets/par/Congo DevOps.jpg';
import { experts } from '../data/experts';
import { membersCarousel } from '../data/members-preview';
import MemberCarousel from '../components/MemberCarousel.astro';

const partnerLogos = [
    { src: '/assets/par/cgdt.jpg', alt: 'Logo partenaire CGDT', class: 'w-24 md:w-35 h-14 md:h-20 object-cover' },
    { src: "/assets/par/Logo de l'ACDN.png", alt: 'Logo partenaire ACDN', class: 'w-40 md:w-65 h-14 md:h-20 object-contain' },
    { src: '/assets/par/galsendev.jpg', alt: 'Logo partenaire GalsenDev', class: 'w-24 md:w-35 h-14 md:h-20 object-contain' },
    { src: '/assets/par/unionlab.jpg', alt: 'Logo partenaire UnionLab', class: 'w-24 md:w-35 h-16 md:h-25 object-cover' },
    { src: '/assets/par/logo.webp', alt: 'Logo partenaire Miabé Hackathon', class: 'w-36 md:w-55 h-14 md:h-20 object-contain' },
    { src: '/assets/par/logo-asso-10000codeurs.png', alt: 'Logo partenaire 10000 Codeurs', class: 'w-24 md:w-35 h-14 md:h-20 object-contain' },
];
---

<Layout>
    <!-- Hero section -->
    <section class="bg-[#fff3ee] flex flex-col lg:flex-row justify-between items-center px-6 md:px-10 font-main py-12 lg:py-20 gap-10">
        <div class="w-full lg:w-1/2 space-y-6 lg:space-y-7">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight lg:leading-15">
                <span class="text-orange-possacode italic font-bold">PossaCode,</span> une <br>
                communauté de <span class="text-orange-possacode italic font-bold">développeurs</span> <span class="text-orange-possacode italic font-bold">impactante</span> en Afrique.
            </h1>
            <div class="flex flex-wrap gap-3">
                <div class="boutton-hero">#Former</div>
                <div class="boutton-hero">#Partager</div>
                <div class="boutton-hero">#Inspirer</div>
                <div class="boutton-hero">#Orienter</div>
                <div class="boutton-hero">#Réseauter</div>
            </div>
            <div class="border-2 border-orange-possacode px-2 py-1 w-full lg:w-115 rounded-lg flex justify-between items-center gap-2">
                <p class="text-xs md:text-xs lg:text-lg text-orange-possacode">Intégrer une communauté </p>
                <a class="boutton-standard text-white text-sm md:text-base whitespace-nowrap" href="">Nous Rejoindre</a>
            </div>
        </div>
        <div class="w-full lg:w-1/2 h-64 md:h-80 lg:h-[500px] flex justify-between items-end gap-3">
            <img class="rounded-2xl flex-1 min-w-0 max-w-[60%] h-full object-cover object-center hover:rotate-3 transition-transform duration-300" src="/assets/femme1.png" alt="">
            <img class="rounded-2xl w-1/3 min-w-0 h-3/4 object-cover object-center hover:rotate-3 transition-transform duration-300 hidden md:block" src="/assets/homme1.png" alt="">
            <img class="rounded-2xl w-1/4 min-w-0 h-1/2 object-cover object-center hover:rotate-3 transition-transform duration-300 hidden lg:block" src="/assets/femme2.png" alt="">
        </div>
    </section>

    <!-- Partenaires Section -->
    <section class="px-6 md:px-10 py-10 md:py-5">
        <h2 class="text-center font-bold text-orange-possacode text-3xl md:text-5xl mb-10 md:mb-20 font-Phudu">Ils nous font confiance</h2>
        <div class="logo-marquee">
            <div class="logo-marquee-track flex items-center">
                <div class="flex items-center gap-6 md:gap-10 pr-6 md:pr-10 shrink-0">
                    {partnerLogos.map((logo) => (
                        <img class={`${logo.class} shrink-0`} src={logo.src} alt={logo.alt} />
                    ))}
                    <Image class="w-24 md:w-35 h-14 md:h-20 object-cover shrink-0" src={congoDevOpsLogo} width={140} densities={[1, 2]} format="webp" alt="Logo partenaire Congo DevOps" />
                </div>
                <div class="flex items-center gap-6 md:gap-10 pr-6 md:pr-10 shrink-0" aria-hidden="true">
                    {partnerLogos.map((logo) => (
                        <img class={`${logo.class} shrink-0`} src={logo.src} alt="" />
                    ))}
                    <Image class="w-24 md:w-35 h-14 md:h-20 object-cover shrink-0" src={congoDevOpsLogo} width={140} densities={[1, 2]} format="webp" alt="" />
                </div>
            </div>
        </div>
    </section>

    <!-- Objective Section -->
    <section class="bg-[#1A2251] px-6 md:px-10 py-12 md:py-20">
        <div class="flex justify-center">
            <div class="inline-block">
                <h2 class="text-white text-3xl md:text-5xl font-Phudu font-bold text-center">Qui <span class="text-orange-possacode">sommes-nous ?</span></h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
        </div>
        <p class="text-center text-white font-nunito font-light text-base md:text-xl mt-5 w-full max-w-4xl mx-auto px-2">
            <span class="text-orange-possacode font-bold">PossaCode</span> est une association qui forme et réunit les développeurs du Congo et d'Afrique à travers des meetUp, des hackatons, ainsi que des conférences techniques dédiées aux développeurs
        </p>

        <!-- Desktop grid -->
        <div class="hidden lg:grid grid-cols-[350px_350px_1fr] grid-rows-[300px_200px_300px] my-20 gap-6">
            <img class="row-span-2 h-full object-cover rounded-2xl" src="/assets/ca.jpg" alt="">
            <div class="bg-white rounded-2xl content-center text-center text-blue-possacode font-bold font-Phudu text-4xl">Plus de <br> <span class="font-light text-orange-possacode">80 Membres</span></div>
            <div class="row-span-3 flex justify-center items-center flex-col gap-5">
                <div class="space-y-5">
                    <p class="text-xl text-justify text-white font-nunito max-w-120">Nous sommes convaincus que la <span class="font-bold text-orange-possacode">formation</span> et l'organisation d'événements de rencontre comme des <span class="font-bold text-orange-possacode">meetUp</span>, des <span class="font-bold text-orange-possacode">hackatons</span>, ainsi que des <span class="font-bold text-orange-possacode">conférences techniques</span> dédiées aux développeurs en Afrique est essentielle pour : le <span class="font-semibold">renforcement des compétences techniques</span> et à l'<span class="font-semibold">amélioration de la qualité du travail</span> des développeurs en Afrique, favoriser les <span class="font-semibold">opportunités de réseautage</span>, d'échange d'expériences et de <span class="font-semibold">partage de connaissances</span> entre les participants, etc...</p>
                    <a href="/about" class="bg-orange-possacode w-50 text-white inline-block text-xl text-center px-1 py-2 rounded-lg">En savoir plus...</a>
                </div>
            </div>
            <div class="bg-[url('/assets/groupe.jpg')] bg-cover bg-left row-span-2 rounded-2xl"></div>
            <div class="bg-white rounded-2xl content-center text-center text-blue-possacode font-bold font-Phudu text-4xl shadow-xl/20 shadow-white">Plus de <br> <span class="font-nunito font-semibold text-orange-possacode">1000 personnes impactées</span></div>
        </div>

        <!-- Mobile / Tablet layout -->
        <div class="lg:hidden flex flex-col gap-6 mt-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <img class="h-64 md:h-80 w-full object-cover rounded-2xl" src="/assets/ca.jpg" alt="">
                <img class="h-64 md:h-80 w-full object-cover object-left rounded-2xl" src="/assets/groupe.jpg" alt="">
            </div>
            <div class="grid grid-cols-2 gap-6">
                <div class="bg-white rounded-2xl p-6 content-center text-center text-blue-possacode font-bold font-Phudu text-2xl md:text-3xl">Plus de <br> <span class="font-light text-orange-possacode">80 Membres</span></div>
                <div class="bg-white rounded-2xl p-6 content-center text-center text-blue-possacode font-bold font-Phudu text-2xl md:text-3xl">Plus de <br> <span class="font-nunito font-semibold text-orange-possacode">1000 personnes impactées</span></div>
            </div>
            <div class="space-y-5">
                <p class="text-base md:text-xl text-justify text-white font-nunito">Nous sommes convaincus que la <span class="font-bold text-orange-possacode">formation</span> et l'organisation d'événements de rencontre comme des <span class="font-bold text-orange-possacode">meetUp</span>, des <span class="font-bold text-orange-possacode">hackatons</span>, ainsi que des <span class="font-bold text-orange-possacode">conférences techniques</span> dédiées aux développeurs en Afrique est essentielle pour : le <span class="font-semibold">renforcement des compétences techniques</span> et à l'<span class="font-semibold">amélioration de la qualité du travail</span> des développeurs en Afrique, favoriser les <span class="font-semibold">opportunités de réseautage</span>, d'échange d'expériences et de <span class="font-semibold">partage de connaissances</span> entre les participants, etc...</p>
                <a href="/about" class="bg-orange-possacode text-white inline-block text-lg text-center px-4 py-2 rounded-lg">En savoir plus...</a>
            </div>
        </div>
    </section>

    <!-- Images Member Section -->
    <section class="bg-white py-6 mb-20 px-6 md:px-10">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <img class="w-full h-56 md:h-72 lg:h-80 object-cover object-top rounded-xl hover:scale-105 transition duration-500" src="/assets/CODEUR.png" alt="">
            <img class="w-full h-56 md:h-72 lg:h-80 object-cover object-left rounded-xl hover:scale-105 transition duration-500" src="/assets/femme3.png" alt="">
            <img class="w-full h-56 md:h-72 lg:h-80 object-cover rounded-xl hover:scale-105 transition duration-500" src="/assets/homme2.png" alt="">
            <img class="w-full h-56 md:h-72 lg:h-80 object-cover object-left rounded-xl hover:scale-105 transition duration-500 hidden md:block" src="/assets/homme1.png" alt="">
            <img class="w-full h-56 md:h-72 lg:h-80 object-cover object-top rounded-xl hover:scale-105 transition duration-500 hidden lg:block" src="/assets/new3.jpg" alt="">
        </div>
    </section>

    <!-- Mission, Valeur, Vision Section -->
    <section class="bg-orange-possacode py-10 px-6 md:px-10 mb-20 flex flex-col lg:flex-row justify-center items-stretch gap-8 lg:gap-30">
        <div class="w-full lg:w-100 border-l-2 text-white p-6 md:p-8">
            <div class="inline-block">
                <h2 class="text-2xl md:text-4xl font-Phudu text-blue-possacode font-bold">Notre vision</h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#1a2251" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
            <p class="text-sm md:text-base font-nunito text-justify text-blue-possacode font-semibold mt-2">
                Nous aspirons à créer une communauté de développeurs en Afrique qui soit inclusive, collaborative et innovante, où les membres peuvent s'entraider pour atteindre leurs objectifs professionnels et personnels, tout en contribuant au développement de l'écosystème technologique africain.
            </p>
        </div>

        <div class="w-full lg:w-100 border-l-2 text-white p-6 md:p-8">
            <div class="inline-block">
                <h2 class="text-2xl md:text-4xl font-Phudu font-bold">Notre mission</h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="white" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
            <p class="text-sm md:text-base font-nunito text-justify font-semibold mt-2">
                Notre mission est de fournir une plateforme de formation, d'échange et de collaboration pour les développeurs en Afrique, afin de renforcer leurs compétences techniques, favoriser les opportunités de réseautage et d'échange d'expériences, et contribuer au développement de l'écosystème technologique africain.
            </p>
        </div>

        <div class="w-full lg:w-100 lg:h-90 border-l-2 text-white p-6 md:p-8">
            <div class="inline-block">
                <h2 class="text-2xl md:text-4xl font-Phudu text-blue-possacode font-bold">Nos valeurs</h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#1a2251" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
            <p class="text-sm md:text-base font-nunito text-justify text-blue-possacode font-semibold mt-2">
                Nous valorisons l'inclusion, la collaboration, l'innovation, la diversité et l'impact social. Nous croyons que chaque membre de notre communauté a un rôle à jouer dans le développement de l'écosystème technologique africain, et nous nous engageons à créer un environnement où chacun peut s'épanouir et contribuer à la croissance de notre communauté.
            </p>
            <img src="/assets/icones/arrow new.png" alt="">
        </div>
    </section>

    <!-- Activities Sections -->
    <section class="px-6 md:px-10 py-8">
        <div class="flex justify-center">
            <div class="inline-block pb-10 md:pb-20">
                <h2 class="font-bold text-3xl md:text-5xl font-Phudu text-blue-possacode">Nos événements</h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>
        </div>
        <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
            <div class="w-full lg:w-1/2 p-2 flex flex-col gap-4">
                <img class="w-full rounded-lg object-cover object-top h-56 md:h-72 lg:h-auto" src="/assets/NOUS.jpg" alt="">
                <p class="text-orange-possacode text-lg font-nunito font-light">25 Mars 2026</p>
                <h2 class="text-xl md:text-2xl font-bold font-Phudu text-blue-possacode">
                    Comment utiliser tailwindcss dans un projet Astro ?
                </h2>
                <p class="text-gray-500 text-base md:text-lg text-justify font-nunito font-light">
                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Dicta, consectetur vel.
                    Voluptatem, expedita architecto eligendi laborum fugiat illo molestias ullam,
                    molestiae repellendus consectetur, ad culpa animi cupiditate provident quae non.
                </p>
                <div class="boutton-standard text-white font-nunito text-center text-base md:text-lg">Participer</div>
            </div>
            <div class="w-full lg:w-1/2 flex flex-col gap-6">
                <div class="border-b border-gray-300 pb-4 flex gap-4">
                    <img class="h-32 md:h-48 lg:h-60 w-36 md:w-56 lg:w-80 object-cover rounded-lg shrink-0" src="/assets/maxresdefault - Copie.jpg" alt="">
                    <div class="content-center space-y-2 md:space-y-3">
                        <p class="text-orange-possacode text-sm md:text-lg font-nunito font-light">25 Mars 2026</p>
                        <h2 class="text-base md:text-2xl font-bold font-Phudu">
                            Comment utiliser tailwindcss dans un projet Astro ?
                        </h2>
                    </div>
                </div>
                <div class="border-b border-gray-300 pb-4 flex gap-4">
                    <img class="h-32 md:h-48 lg:h-60 w-36 md:w-56 lg:w-80 object-cover rounded-lg shrink-0" src="/assets/new1.jpg" alt="">
                    <div class="content-center space-y-2 md:space-y-3">
                        <p class="text-orange-possacode text-sm md:text-lg font-nunito font-light">25 Mars 2026</p>
                        <h2 class="text-base md:text-2xl font-bold font-Phudu">
                            Comment utiliser tailwindcss dans un projet Astro ?
                        </h2>
                    </div>
                </div>
                <div class="border-b border-gray-300 pb-4 flex gap-4">
                    <img class="h-32 md:h-48 lg:h-60 w-36 md:w-56 lg:w-80 object-cover rounded-lg shrink-0" src="/assets/femmecode - Copie.jpg" alt="">
                    <div class="content-center space-y-2 md:space-y-3">
                        <p class="text-orange-possacode text-sm md:text-lg font-nunito font-light">25 Mars 2026</p>
                        <h2 class="text-base md:text-2xl font-bold font-Phudu">
                            Comment utiliser tailwindcss dans un projet Astro ?
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experts Section : masquée tant que chaque portrait n'a pas un nom + rôle réels -->
    {experts.length > 0 && (
        <section class="my-10 mx-4 md:mx-10 p-6 md:p-10 flex flex-col gap-5 items-center">
            <div class="inline-block pb-10 md:pb-20">
                <h2 class="text-2xl md:text-4xl lg:text-5xl text-center font-bold text-blue-possacode font-Phudu">Ces <span class="text-orange-possacode">experts</span> qui impactent notre communauté</h2>
                <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#1a2251" stroke-width="2" fill="transparent" class="wave-line"/>
                </svg>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-8 w-full">
                {experts.map((expert) => (
                    <a
                        href={expert.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex flex-col items-center gap-3 text-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-possacode"
                    >
                        <div
                            style={`background-image: url('${expert.image}')`}
                            class="bg-cover bg-top shadow-xl/10 h-40 w-40 md:h-56 md:w-56 rounded-full ring-0 ring-orange-possacode transition-all duration-200 group-hover:ring-4 group-hover:scale-105"
                        ></div>
                        <div>
                            <p class="font-Phudu font-bold text-blue-possacode transition-colors group-hover:text-orange-possacode">{expert.name}</p>
                            <p class="font-nunito text-sm text-gray-700">{expert.role}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    <!-- Carrousel de portraits membres -->
    <section class="my-10 mx-4 md:mx-10 flex flex-col gap-5 items-center">
        <div class="inline-block pb-8 md:pb-14 text-center">
            <h2 class="text-2xl md:text-4xl lg:text-5xl text-center font-bold text-blue-possacode font-Phudu">Découvrez nos <span class="text-orange-possacode">membres</span></h2>
            <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#1a2251" stroke-width="2" fill="transparent" class="wave-line"/>
            </svg>
        </div>
        <MemberCarousel members={membersCarousel} label="Portraits de membres de la communauté" />
    </section>

    <!-- CTA Section -->
    <section class="bg-blue-possacode px-6 md:px-10 py-16 md:py-24 text-center">
        <div class="inline-block mb-6">
            <h2 class="text-3xl md:text-5xl font-Phudu font-bold text-white">
                Prêt à rejoindre <span class="text-orange-possacode">l'aventure</span> ?
            </h2>
            <svg class="w-full h-4 mt-2" viewBox="0 0 200 20" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 10 Q 5 0, 10 10 T 20 10 T 30 10 T 40 10 T 50 10 T 60 10 T 70 10 T 80 10 T 90 10 T 100 10 T 110 10 T 120 10 T 130 10 T 140 10 T 150 10 T 160 10 T 170 10 T 180 10 T 190 10 T 200 10" stroke="#f14d0e" stroke-width="2" fill="transparent" class="wave-line"/>
            </svg>
        </div>
        <p class="text-white font-nunito font-light text-base md:text-xl max-w-2xl mx-auto mb-8">
            Ensemble, formons, partageons et inspirons la prochaine génération de développeurs africains. Votre place vous attend dans la communauté PossaCode.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <a href="" class="boutton-standard text-white text-base md:text-lg px-8 py-3">Nous Rejoindre</a>
            <a href="" class="border-2 border-white text-white font-bold px-8 py-3 rounded-lg hover:bg-white hover:text-blue-possacode transition">Faire un don</a>
        </div>
    </section>
</Layout>
