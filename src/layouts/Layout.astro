---
import Header from "../components/header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "PossaCode — Communauté de développeurs",
	description = "PossaCode est une communauté de développeurs qui se rassemble pour apprendre, coder et grandir ensemble à travers des événements, des rencontres et des projets collaboratifs.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<meta property="og:title" content={title}>
	<meta property="og:description" content={description}>
	<meta property="og:image" content="/assets/possacodebb.jpg">
</head>
<body>
<div class="bg-[#1A2251] h-10 ">
	<p class=" text-center font-light py-2 text-sm text-gray-200">Première rencontre des <span class="text-[#F14D0E]">PossaCode Dev Girsl</span> prévue pour le samedi 16 Mai</p>
</div>
	<Header  />
	<main >
		 <slot />
	</main>
	<Footer />
</body>
</html>